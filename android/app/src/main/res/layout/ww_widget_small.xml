<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ww_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ww_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/ww_cover_box"
            android:layout_width="38dp"
            android:layout_height="54dp"
            android:background="@drawable/ww_cover_bg">

            <ImageView
                android:id="@+id/ww_cover_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ww_cover_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:maxLines="4"
                android:padding="4dp"
                android:textColor="#FFFFFF"
                android:textSize="7sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/ww_btn_add"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/ww_btn_primary"
            android:contentDescription="Add a book"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@color/ww_on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ww_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@id/ww_btn_add"
            android:layout_toEndOf="@id/ww_cover_box"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ww_on_surface"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:id="@+id/ww_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/ww_on_surface"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ProgressBar
        android:id="@+id/ww_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:indeterminate="false"
        android:max="1000"
        android:maxHeight="5dp"
        android:minHeight="5dp"
        android:progress="0"
        android:progressDrawable="@drawable/ww_progress" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/ww_stat_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:maxLines="1"
            android:textColor="@color/ww_muted"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ww_btn_prev"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/ww_btn_neutral"
                android:contentDescription="Previous book"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="&#8593;"
                android:textColor="@color/ww_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/ww_btn_next"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/ww_btn_neutral"
                android:contentDescription="Next book"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="&#8595;"
                android:textColor="@color/ww_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
