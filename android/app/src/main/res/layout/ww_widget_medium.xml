<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ww_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ww_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/ww_cover_box"
        android:layout_width="72dp"
        android:layout_height="104dp"
        android:background="@drawable/ww_cover_bg">

        <ImageView
            android:id="@+id/ww_cover_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ww_cover_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:maxLines="5"
            android:padding="6dp"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ww_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ww_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ww_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ww_muted"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/ww_stat_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:maxLines="1"
                android:textColor="@color/ww_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/ww_stat_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/ww_on_surface"
                android:textSize="11sp" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/ww_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            android:max="1000"
            android:maxHeight="6dp"
            android:minHeight="6dp"
            android:progress="0"
            android:progressDrawable="@drawable/ww_progress" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="26dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ww_btn_add"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/ww_btn_primary"
            android:contentDescription="Add a book"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@color/ww_on_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/ww_btn_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/ww_btn_neutral"
            android:contentDescription="Previous book"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="&#8593;"
            android:textColor="@color/ww_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ww_btn_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/ww_btn_neutral"
            android:contentDescription="Next book"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="&#8595;"
            android:textColor="@color/ww_muted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
